+    @Test void bundledCatalogV3HasNoProgressionSkipsAndPricesNeverFallBelowTheirStart() {
+        var products = DynamicShopService.load(bundled());
+        for (String skipped : List.of("ELYTRA", "TOTEM_OF_UNDYING", "TRIDENT", "DIAMOND", "NETHERITE_INGOT",
+                "ENCHANTED_GOLDEN_APPLE", "SHULKER_BOX")) {
+            assertTrue(products.stream().noneMatch(p -> p.material().equals(skipped)), skipped);
+        }
+        for (var p : products) {
+            assertEquals(p.basePrice(), p.minPrice(), p.id());
+            assertTrue(p.maxPrice() <= Math.max(p.basePrice() + 2, p.basePrice() * 2), p.id());
+        }
+        var chestplate = products.stream().filter(p -> p.id().equals("diamond_chestplate")).findFirst().orElseThrow();
+        assertEquals(10, chestplate.basePrice());
+        assertEquals(4, chestplate.maxStock());
+        assertEquals(3, bundled().getInt("catalog-version"));
+    }
+    @Test void untouchedCatalogV2GoodsAreRebalancedWhileAdministratorChangesSurvive() throws Exception {
+        var v2 = YamlConfiguration.loadConfiguration(new InputStreamReader(Objects.requireNonNull(
+                getClass().getClassLoader().getResourceAsStream("shop-catalog-v2.yml")), StandardCharsets.UTF_8));
+        var server = new YamlConfiguration();
+        server.loadFromString(v2.saveToString());
+        server.set("products.cobblestone.base-price", 2);
+        server.set("products.sand", null);
+        assertTrue(DynamicShopService.upgrade(server, bundled()));
+        var products = DynamicShopService.load(server);
+        assertEquals(149, products.size());
